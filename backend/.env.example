# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
APP_NAME="ResumeAI"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────
# Database (MySQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=resumeai

# ─────────────────────────────────────────────
# Database (MySQL)
# ─────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/resumeai

# ─────────────────────────────────────────────
# LLM APIs
# ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GROK_API_KEY=your-grok-api-key
GROK_API_BASE_URL=https://api.x.ai/v1/chat/completions

# ─────────────────────────────────────────────
# File Uploads
# ─────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
